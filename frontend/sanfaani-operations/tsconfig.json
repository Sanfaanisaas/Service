{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": true, "jsx": "react-jsx", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true, "allowImportingTsExtensions": true, "moduleResolution": "bundler",
    "types": ["node", "vite/client"], "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  }
}
