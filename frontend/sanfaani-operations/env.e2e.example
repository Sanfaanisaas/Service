# Staging-only values. Copy to the gitignored .env.e2e for local execution.
E2E_BASE_URL=https://staging-operations.example.com
E2E_API_URL=https://staging-api.example.com
E2E_SUPABASE_URL=https://your-staging-project.supabase.co
E2E_SUPABASE_ANON_KEY=your-staging-public-anon-key
E2E_ADMIN_EMAIL=admin-test@example.com
E2E_ADMIN_PASSWORD=replace-in-local-untracked-file
E2E_STAFF_EMAIL=staff-test@example.com
E2E_STAFF_PASSWORD=replace-in-local-untracked-file
E2E_CUSTOMER_EMAIL=customer-role-test@example.com
E2E_CUSTOMER_PASSWORD=replace-in-local-untracked-file
