{
  "name": "@workspace/sanfaani-operations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c yellow,cyan \"pnpm dev:client\" \"pnpm dev:server\"",
    "build": "pnpm build:client && pnpm build:server",
    "serve": "export $(cat .env | xargs) && vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:client": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:server": "tsx watch server/src/index.ts",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/server/src/index.js",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx server/src/seed.ts"
  },
