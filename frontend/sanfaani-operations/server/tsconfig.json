{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/server", "rootDir": "..", "module": "NodeNext", "moduleResolution": "NodeNext",
    "target": "ES2023", "lib": ["ES2023"], "types": ["node"], "noEmit": false,
    "allowImportingTsExtensions": false, "baseUrl": "..", "paths": { "@shared/*": ["shared/*"] }
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"], "exclude": ["**/*.test.ts"]
}
