# Browser-safe SANFAANI frontend configuration only.
# Do not place MONGODB_URI, SUPABASE_SERVICE_ROLE_KEY, or VAPID_PRIVATE_KEY here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Optional API origin. The generated client already includes the `/api` path.
VITE_API_URL=http://localhost:5000
PORT=3000
BASE_PATH=/
