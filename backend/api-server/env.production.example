# Copy to an untracked .env file or configure these in the provider secret manager.
NODE_ENV=production
SERVER_PORT=5000
MONGODB_URI=mongodb://database-host:27017/sanfaani
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
CLIENT_URL=https://operations.example.com
SANFAANI_ADMIN_EMAIL=bootstrap-admin@example.com
VAPID_PUBLIC_KEY=replace-in-secret-manager
VAPID_PRIVATE_KEY=replace-in-secret-manager
VAPID_SUBJECT=mailto:operations@example.com
