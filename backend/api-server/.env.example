# Canonical SANFAANI backend runtime configuration.
# Supabase authenticates users; MongoDB stores all SANFAANI operational data.
NODE_ENV=development
SERVER_PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/sanfaani
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# This deliberately permits only the matching first authenticated user to
# bootstrap as an administrator. All other public sign-ups persist as customer.
SANFAANI_ADMIN_EMAIL=admin@example.com
# Optional Web Push server configuration. Never expose VAPID_PRIVATE_KEY to
# the frontend; VAPID_PUBLIC_KEY is served through the authenticated API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sanfaani.ng
